# Cliente web de Identity Platform (Firebase). Estos valores quedan públicos en el bundle.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# URL pública del portal. Se usa en el enlace del correo de recuperar contraseña.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Cloud SQL. El conector de Node abre la conexión; no hace falta host ni puerto.
# INSTANCE_CONNECTION_NAME tiene la forma PROYECTO:REGION:INSTANCIA.
INSTANCE_CONNECTION_NAME=project:region:instance
DB_USER=app_user
DB_PASSWORD=
DB_NAME=app_db
# PUBLIC (por defecto), PRIVATE o PSC. Cámbialo solo si la instancia no tiene IP pública.
DB_IP_TYPE=PUBLIC
# Ruta local al JSON de la cuenta de servicio. En Cloud Run, omítela y usa la cuenta del servicio.
GOOGLE_APPLICATION_CREDENTIALS=
# Alternativa al archivo: el mismo JSON codificado en base64. Si está definida, reemplaza la ruta de arriba.
GOOGLE_CREDENTIALS_BASE64=

# Apigee Management API (organización, producto y cuenta de servicio que crea developers y apps).
APIGEE_ORG=my-apigee-org
APIGEE_API_PRODUCT_NAME=my-api-product
APIGEE_SA_CLIENT_EMAIL=apigee-provisioner@my-project.iam.gserviceaccount.com
# Clave privada PEM. En el archivo de entorno, los saltos de línea van como \n.
APIGEE_SA_PRIVATE_KEY=
# Environment de Apigee (por ejemplo eval). El cliente actual no la lee; queda documentada para el despliegue.
APIGEE_ENV=eval

# SMTP para correos de soporte. Si falta alguno, el envío se omite.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Buzón interno que recibe los avisos de casos de soporte.
NOTIFICATION_EMAIL=ops@example.com
